# Scanner device — leave blank to auto-detect at startup
SCANNER_DEVICE=

# Auto color detection (reduces file size for grayscale documents)
COLOR_DETECT=true

# Blank-page skip threshold (% dark pixels). 0 = disabled (default) — a
# nonzero value can silently discard real pages with low ink coverage
# (e.g. a mostly-blank signature page). Only raise this after measuring
# real ink coverage across your documents; see README "Blank-page skip
# false positives".
SWSKIP=0

# Paperless API mode
PAPERLESS_URL=
PAPERLESS_TOKEN=

# Paperless folder mode — set to /consume and mount your folder in compose.yml
PAPERLESS_CONSUME_DIR=

# Notifications — space-separated Apprise URLs, blank to disable
# See: https://github.com/caronc/apprise/wiki
APPRISE_URLS=
