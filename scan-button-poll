#!/bin/bash
# scan-button-poll - Poll ScanSnap ix500 button and trigger scan
# Designed to be started/stopped by udev on USB connect/disconnect

POLL_INTERVAL=0.1
DEBOUNCE=3

# Resolve scan script relative to this script's location
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
SCAN_SCRIPT="$SCRIPT_DIR/scan"

log() {
    echo "[$(date '+%H:%M:%S')] $1"
}

notify() {
    [ -z "$APPRISE_URLS" ] && return
    local title="$1" body="$2"
    read -ra _urls <<< "$APPRISE_URLS"
    apprise -t "$title" -b "$body" "${_urls[@]}" 2>/dev/null &
}

# USB command timeout — bounds how long a wedged scanner (e.g. right after
# a disconnect/re-enumeration) can block a single poll iteration. 30s is
# generous headroom over normal scanimage round-trips (observed up to ~16s)
# without misfiring during ordinary, if occasionally slow, operation.
SCAN_CMD_TIMEOUT=30

# Auto-detect scanner device (fallback when SCANNER_DEVICE is not set)
detect_device() {
    timeout "$SCAN_CMD_TIMEOUT" scanimage -L 2>/dev/null | grep -oE "fujitsu:ScanSnap iX500:[0-9]+" | head -1
}

get_button_state() {
    local result
    result=$(timeout "$SCAN_CMD_TIMEOUT" scanimage --device "$DEVICE" -A 2>/dev/null | sed -En 's/.*--scan\[[^]]*\] \[([a-z]+)\].*/\1/p')
    echo "${result:-error}"
}

# Preserve the user's original config before SCANNER_DEVICE gets
# overwritten below — `[ -z "$USER_SCANNER_DEVICE" ]` is what decides
# whether to auto-redetect later, same as the original semantics.
USER_SCANNER_DEVICE="$SCANNER_DEVICE"

# Scanner device — from env or auto-detect
if [ -n "$USER_SCANNER_DEVICE" ]; then
    DEVICE="$USER_SCANNER_DEVICE"
else
    DEVICE=$(detect_device)
fi
if [ -z "$DEVICE" ]; then
    log "Error: ScanSnap iX500 not found"
    exit 1
fi

# Export what we just found so `scan` (which does its own untimed
# scanimage -L when SCANNER_DEVICE is unset) doesn't redundantly
# re-detect on every single trigger — that redetect was adding the
# scanimage -L round-trip (~15-20s observed) to every button press
# before scanning actually started.
export SCANNER_DEVICE="$DEVICE"

log "Starting button poll for $DEVICE"

# Wait for scanner to be ready
sleep 2

# Main polling loop
while true; do
    button_state=$(get_button_state)

    if [ "$button_state" = "yes" ]; then
        log "Button pressed! Starting scan..."

        # Run the scan script, capture output
        SCAN_OUTPUT=$("$SCAN_SCRIPT" 2>&1) && SCAN_OK=true || SCAN_OK=false
        echo "$SCAN_OUTPUT"

        if [ "$SCAN_OK" = true ]; then
            log "Scan completed successfully"
            DONE_MSG=$(echo "$SCAN_OUTPUT" | grep "^Done:" | tail -1)
            if [ -n "$PAPERLESS_URL" ]; then
                notify "Scan Complete" "${DONE_MSG:-Document uploaded to Paperless}"$'\n'"$PAPERLESS_URL"
            else
                notify "Scan Complete" "${DONE_MSG:-Scan saved successfully}"
            fi
        else
            log "Scan failed"
            notify "Scan Failed" "Something went wrong. Check logs: journalctl --user -u scan-button.service"
        fi

        # Debounce - wait before polling again to let button release
        log "Waiting for button release..."
        sleep "$DEBOUNCE"

    elif [ "$button_state" = "error" ]; then
        log "Scanner not responding, waiting..."
        sleep 5
        if [ -z "$USER_SCANNER_DEVICE" ]; then
            DEVICE=$(detect_device)
            export SCANNER_DEVICE="$DEVICE"
        fi
    fi

    sleep "$POLL_INTERVAL"
done
