#!/bin/bash
# scan - Quick scan from ScanSnap ix500
#
# Three modes (determined by environment variables):
#   Paperless API mode:    PAPERLESS_URL and PAPERLESS_TOKEN set
#                          → uploads PDF to Paperless-ngx via API
#   Paperless folder mode: PAPERLESS_CONSUME_DIR set
#                          → writes PDF directly to consume folder
#   Local mode:            none of the above set
#                          → runs OCR locally, saves to ~/Documents/scanner-inbox/
#
# Features:
# - A4 page size with bleed margin for edge-to-edge capture
# - Duplex (both sides)
# - Color scan with optional auto-grayscale conversion (COLOR_DETECT)
# - Optional skip of blank pages (back sides) — off by default, see SWSKIP
# - Multi-page batch to single PDF

set -e

# Blank-page skip threshold, in percent of dark pixels (SANE fujitsu
# backend's own --swskip option). A page-side whose ink coverage is below
# this gets silently discarded by the driver *before* scan ever sees an
# image for it — there is no captured file to recover, no error, nothing
# in `journalctl` by default. Confirmed on a real document: a signature
# page (mostly white, just a signature + a couple of printed lines) was
# well under the old default of 20%, so it vanished with the batch simply
# reporting fewer pages than were fed. Defaults to 0 (disabled) — a false
# positive here means a real page is gone for good, which is worse than an
# occasional true-blank duplex backside making it into the output PDF.
# Override via SWSKIP only after measuring real ink coverage across your
# documents; see "Blank-page skip false positives" in the README.
SWSKIP="${SWSKIP:-0}"

# Scanner device — from env or auto-detect
if [ -n "$SCANNER_DEVICE" ]; then
    DEVICE="$SCANNER_DEVICE"
else
    DEVICE=$(scanimage -L 2>/dev/null | grep -oE "fujitsu:ScanSnap iX500:[0-9]+" | head -1)
fi
if [ -z "$DEVICE" ]; then
    echo "Error: ScanSnap iX500 not found. Is it connected and powered on?"
    exit 1
fi

# Determine mode
if [ -n "$PAPERLESS_URL" ] && [ -n "$PAPERLESS_TOKEN" ]; then
    MODE=paperless-api
elif [ -n "$PAPERLESS_CONSUME_DIR" ]; then
    MODE=paperless-folder
else
    MODE=local
fi

# Bleed margin for edge-to-edge capture (avoids cut-off edges)
BLEED_MM=10
PAGE_WIDTH_MM=$((210 + BLEED_MM))
PAGE_HEIGHT_MM=$((297 + BLEED_MM))

TIMESTAMP=$(date '+%Y-%m-%d-%H%M%S')
FILENAME="${1:-scan-$TIMESTAMP}"

# Scratch dir for the page TIFFs. Defaults to /var/tmp, NOT the system default
# of /tmp: on many systemd distros /tmp is tmpfs (RAM-backed), and a multi-page
# 300dpi colour scan is ~32MB of TIFF per page — on a memory-constrained host
# (e.g. a 1GB LXC) scanimage dumping a 29-page batch into tmpfs is ~1GB of
# unreclaimable RAM before magick even runs, which OOM-kills the job. /var/tmp
# is disk-backed, so the working set stays as reclaimable page cache. Override
# with TMPDIR. Falls back to the mktemp default if /var/tmp isn't usable.
SCRATCH_BASE="${TMPDIR:-/var/tmp}"
WORKDIR=$(mktemp -d "$SCRATCH_BASE/ix500.XXXXXXXX" 2>/dev/null || mktemp -d)

# On a clean exit, or a failure before any page was scanned, just bin the
# scratch dir. But if scanimage produced pages and a *later* step failed
# (PDF assembly, upload, consume-folder write), keep the TIFFs so the job can
# be re-assembled without feeding the paper through the ADF again — see
# "Recovering a failed scan" in the README. Only the most recent failure is
# kept; older ones are pruned here so they can't fill the disk, and
# systemd-tmpfiles sweeps /var/tmp at 30 days as a backstop.
cleanup() {
    local rc=$?
    if [ "$rc" -ne 0 ] && compgen -G "$WORKDIR/page-*.tiff" >/dev/null; then
        local kept="$SCRATCH_BASE/ix500-failed-$TIMESTAMP"
        if mv "$WORKDIR" "$kept" 2>/dev/null; then
            ls -dt "$SCRATCH_BASE"/ix500-failed-* 2>/dev/null | tail -n +2 | xargs -r rm -rf
            echo "Scan failed after $(compgen -G "$kept/page-*.tiff" | wc -l) page(s) were captured." >&2
            echo "Kept the scanned pages at: $kept" >&2
        fi
        return
    fi
    rm -rf "$WORKDIR"
}
trap cleanup EXIT

# Assemble the per-page TIFFs into one JPEG-compressed PDF, one page at a
# time. A single `magick page-*.tiff out.pdf` call loads every page's raw
# raster into memory at once — a 29-page 300dpi colour scan (raw TIFFs
# ~32MB each) OOM-killed magick on a 1GB host, losing the scan silently.
# Converting each page to its own one-page PDF first keeps peak memory at
# ~one page; ghostscript then concatenates the (already tiny) single-page
# PDFs cheaply. Writes to a temp file and renames into place so a consumer
# polling the output dir never sees a partial PDF.
assemble_pdf() {
    local out="$1" tmp page
    tmp=$(mktemp "$(dirname "$out")/.$(basename "$out").XXXXXX")
    for page in "$WORKDIR"/page-*.tiff; do
        magick "$page" -compress JPEG -quality 75 "$page.pdf"
    done
    gs -q -dNOPAUSE -dBATCH -dSAFER -sDEVICE=pdfwrite \
        -sOutputFile="$tmp" "$WORKDIR"/page-*.tiff.pdf
    chmod 644 "$tmp"   # mktemp makes it 0600; Paperless's consumer must be able to read it
    mv "$tmp" "$out"
}

echo "Scanning (duplex, color, A4)..."
# SANE_DEBUG_FUJITSU=5 is the fujitsu backend's own log level for its
# swskip decision ("buffer_isblank: blank!") — everything else at that
# level is attach/config error conditions that don't fire in normal
# operation, so it's quiet enough to run on every scan (unlike higher
# levels, which also dump every raw USB command/packet). We capture it to
# a file so we can translate that one line into a plain warning below,
# instead of it only being visible by re-running with debug logging after
# the fact.
SCAN_LOG="$WORKDIR/.scanimage.log"
SANE_DEBUG_FUJITSU=5 scanimage --device "$DEVICE" \
    --format=tiff \
    --resolution 300 \
    --mode Color \
    --source "ADF Duplex" \
    --page-width "$PAGE_WIDTH_MM" \
    --page-height "$PAGE_HEIGHT_MM" \
    --swskip "$SWSKIP" \
    --swcrop=yes \
    --swdespeck 2 \
    --overscan On \
    --prepick On \
    --buffermode On \
    --batch="$WORKDIR/page-%04d.tiff" \
    --batch-count=-1 \
    > "$SCAN_LOG" 2>&1 || true
grep -v "buffer_isblank:\|^$" "$SCAN_LOG"

# Count scanned pages
PAGECOUNT=$(ls -1 "$WORKDIR"/page-*.tiff 2>/dev/null | wc -l)

# Count page-sides the driver discarded as blank (see SWSKIP above) — with
# SWSKIP=0 this is always 0, but if it's ever raised, surface it instead
# of leaving the drop silent. scan-button-poll forwards any "WARNING:"
# line into the Apprise notification alongside the normal "Done:" one.
DISCARD_COUNT=$(grep -c "buffer_isblank: blank!" "$SCAN_LOG" || true)

if [ "$PAGECOUNT" -eq 0 ]; then
    if [ "${DISCARD_COUNT:-0}" -gt 0 ]; then
        echo "WARNING: $DISCARD_COUNT page-side(s) discarded as blank (swskip=${SWSKIP}%) and no pages remain"
    fi
    echo "No pages scanned (feeder empty?)"
    exit 1
fi

echo "Scanned $PAGECOUNT page(s)"
if [ "${DISCARD_COUNT:-0}" -gt 0 ]; then
    echo "WARNING: $DISCARD_COUNT page-side(s) discarded as blank by the scanner driver (swskip=${SWSKIP}%) — check nothing wanted was dropped"
fi

# Clean up background — raw scanimage output has no exposure/white-balance
# correction (unlike OEM ScanSnap Manager), so the whole page comes out
# visibly gray, and faint paper-texture shadows/bleed-through from the
# other side of the page render at much higher contrast than they should.
# Clipping the white point pushes light background noise to pure white
# while leaving actual (much darker) text/ink untouched. Verified against
# a real sample: eliminates visible crease lines and bleed-through, no
# effect on text crispness or color accuracy (logo colors unaffected).
echo "Cleaning up background..."
for tiff in "$WORKDIR"/page-*.tiff; do
    magick "$tiff" -level 0%,90% "$tiff"
done

# Auto-detect color vs grayscale for each page (reduces file size)
# Can be disabled with COLOR_DETECT=false
if [ "${COLOR_DETECT:-true}" = "true" ]; then
    echo "Detecting color..."
    COLOR_PAGES=0
    GRAY_PAGES=0
    for tiff in "$WORKDIR"/page-*.tiff; do
        # Check color saturation - if mean saturation < 10%, convert to grayscale
        saturation=$(magick "$tiff" -colorspace HSL -channel G -separate +channel -format "%[fx:mean*100]" info: 2>/dev/null || echo "0")
        if (( $(echo "$saturation < 10" | bc -l) )); then
            magick "$tiff" -colorspace Gray "$tiff"
            GRAY_PAGES=$((GRAY_PAGES + 1))
        else
            COLOR_PAGES=$((COLOR_PAGES + 1))
        fi
    done

    if [ "$GRAY_PAGES" -gt 0 ] && [ "$COLOR_PAGES" -gt 0 ]; then
        echo "Mixed: $COLOR_PAGES color, $GRAY_PAGES grayscale"
    elif [ "$GRAY_PAGES" -gt 0 ]; then
        echo "Converted to grayscale"
    else
        echo "Color detected"
    fi
else
    echo "Color detection disabled, converting to grayscale..."
    for tiff in "$WORKDIR"/page-*.tiff; do
        magick "$tiff" -colorspace Gray "$tiff"
    done
fi

if [ "$MODE" = "paperless-api" ]; then
    echo "Creating PDF..."
    # -compress JPEG -quality 75 takes a 300dpi color A4 page from ~32MB to
    # <1MB with no visible artifact difference from quality 60 or 85 (without
    # -compress JPEG, ImageMagick's PDF output defaults to a near-lossless
    # encoding *larger* than the raw pixel data — measured 127% "compression").
    # Paperless does its own OCR/archive optimization on ingest, so the
    # incoming file only needs to look right, not be lossless.
    assemble_pdf "$WORKDIR/$FILENAME.pdf"

    echo "Uploading to Paperless..."
    COOKIE_JAR="$WORKDIR/cookies.txt"
    curl -sc "$COOKIE_JAR" -H "Authorization: Token $PAPERLESS_TOKEN" \
        "$PAPERLESS_URL/api/" > /dev/null 2>&1 || true
    CSRF=$(grep csrftoken "$COOKIE_JAR" 2>/dev/null | awk '{print $NF}')
    CURL_EXTRA=()
    [ -n "$CSRF" ] && CURL_EXTRA+=(-H "X-CSRFToken: $CSRF")
    RESPONSE=$(curl -sk -w "\n%{http_code}" \
        -b "$COOKIE_JAR" \
        -H "Authorization: Token $PAPERLESS_TOKEN" \
        "${CURL_EXTRA[@]}" \
        -F "document=@$WORKDIR/$FILENAME.pdf" \
        -F "created=$(date '+%Y-%m-%d')" \
        "$PAPERLESS_URL/api/documents/post_document/")

    HTTP_CODE=$(echo "$RESPONSE" | tail -1)
    if [ "$HTTP_CODE" -eq 200 ]; then
        FILESIZE=$(ls -lh "$WORKDIR/$FILENAME.pdf" | awk '{print $5}')
        echo "Done: $FILENAME.pdf ($PAGECOUNT pages, $FILESIZE) uploaded to Paperless"
    else
        echo "Upload failed (HTTP $HTTP_CODE)"
        BODY=$(echo "$RESPONSE" | sed '$d')
        [ -n "$BODY" ] && echo "$BODY"
        exit 1
    fi

elif [ "$MODE" = "paperless-folder" ]; then
    OUTFILE="$PAPERLESS_CONSUME_DIR/$FILENAME.pdf"

    echo "Creating PDF..."
    assemble_pdf "$OUTFILE"

    FILESIZE=$(ls -lh "$OUTFILE" | awk '{print $5}')
    echo "Done: $OUTFILE ($PAGECOUNT pages, $FILESIZE)"

else
    OUTDIR="$HOME/Documents/scanner-inbox"
    OUTFILE="$OUTDIR/$FILENAME.pdf"
    mkdir -p "$OUTDIR"

    echo "Running OCR..."
    assemble_pdf "$WORKDIR/combined.pdf"
    ocrmypdf "$WORKDIR/combined.pdf" "$OUTFILE" \
        -l nld+eng \
        --rotate-pages \
        --rotate-pages-threshold 2 \
        --deskew \
        --clean \
        -O 3 \
        --jpeg-quality 60 \
        --jbig2-lossy

    FILESIZE=$(ls -lh "$OUTFILE" | awk '{print $5}')
    echo "Done: $OUTFILE ($PAGECOUNT pages, $FILESIZE)"
fi
